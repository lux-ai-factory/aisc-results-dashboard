# Copy to .env and fill in the three secrets; the rest have safe defaults.
#
# They have no defaults on purpose. SUPERSET_SECRET_KEY signs this dashboard's
# session cookies, so a value that ships in the repository is a session anyone
# can mint. Generate each of these:
#
#   openssl rand -hex 32
#
# ---- core (no defaults: the stack refuses to start without them) ----
SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
IMMUDB_PASSWORD=

# ---- your results database (read-only user recommended) ----
# The shared Testing DB Superset reads. Register it as a connection after init.
AISC_RESULTS_DB_URI=

# ---- branding: leave BLANK for the default AISC identity ----------------------
# To white-label for a company:
#   1. drop its logo at   branding/<company>/logo.png
#   2. set the vars below (BRANDING_LOGO path is what the browser requests, i.e.
#      /static/assets/branding/<company>/logo.png)
#   3. `docker compose up -d`  (NO rebuild needed)
BRANDING_APP_NAME=
BRANDING_LOGO=
BRANDING_PRIMARY=
BRANDING_SECONDARY=

# ---- interactive embedding ----------------------------------------------------
# Comma-separated origins allowed to frame the dashboard/charts in an <iframe>.
# Charts stay fully interactive (legend toggle, cross-filters). Auth rides the
# viewer's Keycloak SSO session -> REQUIRES serving over HTTPS for cross-origin.
# e.g. EMBED_ALLOWED_ORIGINS=https://portal.example.com,https://reports.example.com
EMBED_ALLOWED_ORIGINS=

# ---- Keycloak SSO (set AISC_OAUTH=1 to enable) --------------------------------
AISC_OAUTH=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ---- audit ledger ----
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
